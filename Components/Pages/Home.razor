@page "/"
@inject trabalho_poo.Services.EstoqueService EstoqueService
@inject NavigationManager Navigation

<PageTitle>Login - SmartEstoque</PageTitle>

<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh;">
    <div class="card" style="width: 100%; max-width: 400px;">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-weight: 700; color: white;">📦 SmartEstoque</h2>
            <p style="color: var(--text-secondary);">Faça login para continuar</p>
        </div>
        
        @if (erro)
        {
            <div class="alert-custom alert-danger-custom">
                <span class="bi bi-exclamation-octagon"></span> Usuário ou senha incorretos. Dica: use admin / admin
            </div>
        }

        <form @onsubmit="Entrar" @onsubmit:preventDefault="true">
            <div style="margin-bottom: 20px;">
                <label class="form-label">Usuário</label>
                <input type="text" class="form-control" @bind="usuarioInput" @bind:event="oninput" placeholder="admin" />
            </div>
            <div style="margin-bottom: 30px;">
                <label class="form-label">Senha</label>
                <input type="password" class="form-control" @bind="senhaInput" @bind:event="oninput" placeholder="******" />
            </div>
            
            <button type="submit" class="btn-primary" style="width: 100%; font-size: 1.1rem; padding: 12px;">Entrar no Sistema</button>
        </form>
    </div>
</div>

@code {
    private string usuarioInput = "";
    private string senhaInput = "";
    private bool erro = false;

    protected override void OnInitialized()
    {
        if (EstoqueService.IsLogado)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private void Entrar()
    {
        // Instanciação de Usuário
        var usr = new trabalho_poo.Models.Usuario();
        
        // Chamada de método da classe base
        if (usr.EfetuarLogin(usuarioInput, senhaInput))
        {
            EstoqueService.IsLogado = true;
            EstoqueService.UsuarioLogado.Username = usuarioInput;
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            erro = true;
        }
    }
}
