@page "/produto/{Id:guid}"
@inject trabalho_poo.Services.EstoqueService EstoqueService
@inject NavigationManager Navigation
@using trabalho_poo.Models
@using System.Linq

<PageTitle>Histórico do Produto - SmartEstoque</PageTitle>

@if (produto == null)
{
    <p>Produto não encontrado.</p>
    <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/dashboard")'>Voltar</button>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Detalhes: @produto.Descricao</h2>
    <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/dashboard")'>
        <span class="bi bi-arrow-left"></span> Voltar
    </button>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <small style="color: var(--text-secondary);">Estoque Atual</small>
            <h3 class="@(produto.ValidarEstoque() == "CRITICO" ? "text-danger" : (produto.ValidarEstoque() == "AVISO" ? "text-warning" : "text-success"))">
                @produto.Quantidade / @produto.TetoPermitido
            </h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <small style="color: var(--text-secondary);">Custo Médio Atual (RN03)</small>
            <h3>@produto.CustoMedioAtual.ToString("C")</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <small style="color: var(--text-secondary);">Valor Total Estoque</small>
            <h3>@produto.ValorTotalEstoque.ToString("C")</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <small style="color: var(--text-secondary);">Último Fornecedor</small>
            <strong>@(!string.IsNullOrEmpty(produto.UltimoFornecedor) ? produto.UltimoFornecedor : "-")</strong>
        </div>
    </div>
</div>

<div class="card mb-4">
    <h4>Nova Movimentação</h4>
    
    @if (!string.IsNullOrEmpty(msgErroMovimentacao))
    {
        <div class="alert-custom alert-danger-custom mb-3">@msgErroMovimentacao</div>
    }

    <div class="row">
        <div class="col-md-3">
            <label class="form-label">Tipo</label>
            <select class="form-control" @bind="tipoNovaMovimentacao">
                <option value="COMPRA">Entrada (Compra)</option>
                <option value="VENDA">Saída (Venda)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Data (Retroativa Permitida)</label>
            <input type="datetime-local" class="form-control" @bind="dataNovaMovimentacao" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Qtd</label>
            <input type="number" class="form-control" @bind="qtdNovaMovimentacao" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Vlr Unitário</label>
            <input type="number" class="form-control" @bind="vlrUnitNovaMovimentacao" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn-primary w-100" style="margin-bottom: 15px;" @onclick="AdicionarMovimentacao">Lançar</button>
        </div>
    </div>
</div>

<div class="card">
    <h4>Histórico de Operações (CRUD)</h4>
    <table class="table-dark">
        <thead>
            <tr>
                <th>Data/Hora</th>
                <th>Tipo</th>
                <th>Qtd</th>
                <th>Vlr Unit</th>
                <th>Total</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var op in produto.HistoricoOperacoes.OrderByDescending(o => o.DataHora))
            {
                <tr>
                    <td>@op.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (op is Compra) { <span class="badge-success">COMPRA</span> }
                        else if (op is Venda) { <span class="badge-warning">VENDA</span> }
                    </td>
                    <td>@op.Quantidade</td>
                    <td>@op.ValorUnitario.ToString("C")</td>
                    <td>@op.ValorTotal.ToString("C")</td>
                    <td>
                        <button class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem;" @onclick="() => AbrirModalEdicao(op)"><span class="bi bi-pencil"></span></button>
                        <button class="btn btn-danger" style="padding: 5px 10px; font-size: 0.8rem;" @onclick="() => ExcluirOperacao(op)"><span class="bi bi-trash"></span></button>
                    </td>
                </tr>
            }
            @if(produto.HistoricoOperacoes.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">Nenhuma operação registrada.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal de Edição de Operação -->
@if (mostrarModalEdicao && operacaoEmEdicao != null)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h3>Editar Lançamento</h3>
            
            @if (!string.IsNullOrEmpty(msgErroEdicao))
            {
                <div class="alert-custom alert-danger-custom mb-3 mt-3 text-start">@msgErroEdicao</div>
            }

            <div class="mb-3 text-start mt-3">
                <label class="form-label">Data/Hora</label>
                <input type="datetime-local" class="form-control" @bind="editDataHora" />
            </div>
            <div class="mb-3 text-start">
                <label class="form-label">Quantidade</label>
                <input type="number" class="form-control" @bind="editQuantidade" />
            </div>
            <div class="mb-3 text-start">
                <label class="form-label">Valor Unitário</label>
                <input type="number" class="form-control" @bind="editValorUnitario" />
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <button class="btn btn-secondary" @onclick="FecharModalEdicao">Cancelar</button>
                <button class="btn-primary" @onclick="SalvarEdicao">Salvar Alterações</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Produto? produto;

    private string tipoNovaMovimentacao = "COMPRA";
    private DateTime dataNovaMovimentacao = DateTime.Now;
    private int qtdNovaMovimentacao = 1;
    private decimal vlrUnitNovaMovimentacao = 0;
    
    private string msgErroMovimentacao = "";

    // Propriedades para edição
    private bool mostrarModalEdicao = false;
    private Operacao? operacaoEmEdicao;
    private DateTime editDataHora;
    private int editQuantidade;
    private decimal editValorUnitario;
    private string msgErroEdicao = "";

    protected override void OnInitialized()
    {
        if (!EstoqueService.IsLogado)
        {
            Navigation.NavigateTo("/");
            return;
        }

        produto = EstoqueService.Produtos.FirstOrDefault(p => p.Id == Id);
    }

    private void AdicionarMovimentacao()
    {
        msgErroMovimentacao = "";

        if (qtdNovaMovimentacao <= 0)
        {
            msgErroMovimentacao = "A quantidade deve ser maior que zero.";
            return;
        }

        if (tipoNovaMovimentacao == "COMPRA")
        {
            // Valida Teto
            if (produto!.Quantidade + qtdNovaMovimentacao > produto.TetoPermitido)
            {
                msgErroMovimentacao = $"Não é possível comprar esta quantidade. O teto máximo é {produto.TetoPermitido}.";
                return;
            }

            var compra = new Compra()
            {
                DataHora = dataNovaMovimentacao,
                Quantidade = qtdNovaMovimentacao,
                ValorUnitario = vlrUnitNovaMovimentacao
            };
            produto.HistoricoOperacoes.Add(compra);
            produto.Quantidade += qtdNovaMovimentacao;
        }
        else if (tipoNovaMovimentacao == "VENDA")
        {
            // RN05: Não permitir venda de produtos zerados / não permitir ficar negativo
            if (produto!.Quantidade == 0 || (produto.Quantidade - qtdNovaMovimentacao < 0))
            {
                msgErroMovimentacao = "Venda não permitida. Estoque insuficiente.";
                return;
            }

            var venda = new Venda()
            {
                DataHora = dataNovaMovimentacao,
                Quantidade = qtdNovaMovimentacao,
                ValorUnitario = vlrUnitNovaMovimentacao
            };
            produto.HistoricoOperacoes.Add(venda);
            produto.Quantidade -= qtdNovaMovimentacao;
        }

        produto!.CalcularCustoMedio();
        
        // Reset campos
        qtdNovaMovimentacao = 1;
        vlrUnitNovaMovimentacao = 0;
        dataNovaMovimentacao = DateTime.Now;
    }

    private void ExcluirOperacao(Operacao op)
    {
        // Reverter o saldo do estoque
        if (op is Compra)
        {
            produto!.Quantidade -= op.Quantidade;
        }
        else if (op is Venda)
        {
            produto!.Quantidade += op.Quantidade;
        }

        produto!.HistoricoOperacoes.Remove(op);
        produto.CalcularCustoMedio();
    }

    private void AbrirModalEdicao(Operacao op)
    {
        operacaoEmEdicao = op;
        editDataHora = op.DataHora;
        editQuantidade = op.Quantidade;
        editValorUnitario = op.ValorUnitario;
        msgErroEdicao = "";
        mostrarModalEdicao = true;
    }

    private void FecharModalEdicao()
    {
        mostrarModalEdicao = false;
        operacaoEmEdicao = null;
    }

    private void SalvarEdicao()
    {
        msgErroEdicao = "";
        
        if (operacaoEmEdicao != null)
        {
            if (editQuantidade <= 0)
            {
                msgErroEdicao = "A quantidade deve ser maior que zero.";
                return;
            }

            // Simular novo estoque para verificar limite/negativo
            int novoEstoque = produto!.Quantidade;
            
            if (operacaoEmEdicao is Compra)
            {
                novoEstoque = novoEstoque - operacaoEmEdicao.Quantidade + editQuantidade;
            }
            else if (operacaoEmEdicao is Venda)
            {
                novoEstoque = novoEstoque + operacaoEmEdicao.Quantidade - editQuantidade;
            }

            if (novoEstoque < 0)
            {
                msgErroEdicao = "A edição não pode deixar o estoque geral negativo.";
                return;
            }

            produto!.Quantidade = novoEstoque;
            operacaoEmEdicao.DataHora = editDataHora;
            operacaoEmEdicao.Quantidade = editQuantidade;
            operacaoEmEdicao.ValorUnitario = editValorUnitario;

            produto.CalcularCustoMedio();
        }
        FecharModalEdicao();
    }
}
